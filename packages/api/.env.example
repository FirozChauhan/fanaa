# Fanaa API — copy to .env and fill in
# Local Postgres:  postgres://user:pass@localhost:5432/fanaa
# Neon:            postgresql://<user>:<pass>@<host>/<db>?sslmode=require  (use the pooled URL)
DATABASE_URL=

# Optional — Clerk secret key. When set, email verification is delegated to
# Clerk's email_code OTP (Clerk sends the emails — no SMTP/DKIM/Resend of our
# own). Get it from clerk.com → your app → API Keys.
# Without it, verification codes are logged to the server console (dev mode)
# instead of emailed. The dev fallback is REFUSED unless you explicitly opt in
# with FANAA_ALLOW_DEV_AUTH=1 (below) — a prod deploy without a Clerk key then
# fails closed (auth unavailable) instead of becoming an auth bypass.
# CLERK_SECRET_KEY=

# Explicit opt-in for the dev OTP fallback above (codes logged to console).
# For local development only — never set this in production.
# FANAA_ALLOW_DEV_AUTH=1

PORT=8787
