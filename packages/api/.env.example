# Fanaa API — copy to .env and fill in
# Local Postgres:  postgres://user:pass@localhost:5432/fanaa
# Neon:            postgresql://<user>:<pass>@<host>/<db>?sslmode=require  (use the pooled URL)
DATABASE_URL=

# Optional — without it, verification codes are logged to the server console
# (dev mode) instead of emailed.
RESEND_API_KEY=
# Must be a sender you've verified with Resend.
FANAA_API_FROM=Fanaa <onboarding@resend.dev>

# Optional — Clerk secret key. When set, email OTP is handled by Clerk
# (email_code verification; Clerk sends the emails, no SMTP/DKIM of our own)
# and RESEND_API_KEY is ignored. Get it from clerk.com → your app → API Keys.
# CLERK_SECRET_KEY=

PORT=8787
