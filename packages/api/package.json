{
  "name": "fanaa-api",
  "version": "0.4.2",
  "type": "module",
  "private": true,
  "description": "Fanaa v0.2 API — email OTP auth + letter sync (Hono on Neon/Postgres)",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/server.ts",
    "migrate": "bun run scripts/migrate.ts",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "hono": "^4.13.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250601.0",
    "@types/bun": "latest",
    "wrangler": "^4.14.0"
  }
}
